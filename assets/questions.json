[
 {
  "id": 1,
  "theme": "世界尽头·美好认知",
  "style": "抽象文艺",
  "text": "假如明天就是世界的最后一天，而你只能做一件事，你会——",
  "options": [
   {
    "key": "A",
    "text": "和最在乎的人一起看一场日落",
    "delta": {
     "D4": 2,
     "D12": 2,
     "D8": 1
    }
   },
   {
    "key": "B",
    "text": "独自爬上最高的地方，把世界最后的样子看个够",
    "delta": {
     "D4": -1,
     "D12": 2,
     "D8": 1
    }
   },
   {
    "key": "C",
    "text": "把所有没说完的话、没做完的事，写成一封信",
    "delta": {
     "D2": 1,
     "D9": 2,
     "D8": 1
    }
   },
   {
    "key": "D",
    "text": "像往常一样，过完普普通通的一天",
    "delta": {
     "D8": 2,
     "D1": -2,
     "D11": -1
    }
   },
   {
    "key": "E",
    "text": "去找那个据说会终结世界的原因，哪怕只是看一眼",
    "delta": {
     "D1": 2,
     "D7": 1,
     "D8": 1
    }
   }
  ]
 },
 {
  "id": 2,
  "theme": "友情·困难应对",
  "style": "具体情境",
  "text": "你的挚友被全班孤立、流言四起，你会——",
  "options": [
   {
    "key": "A",
    "text": "站到朋友身边，哪怕一起被孤立",
    "delta": {
     "D4": 2,
     "D6": 2,
     "D3": 1
    }
   },
   {
    "key": "B",
    "text": "先悄悄查清流言的源头，再想办法",
    "delta": {
     "D2": 2,
     "D4": 1
    }
   },
   {
    "key": "C",
    "text": "相信朋友能扛过去，在远处守着",
    "delta": {
     "D4": -1,
     "D13": 1,
     "D5": -1
    }
   },
   {
    "key": "D",
    "text": "劝朋友先低头道歉、息事宁人",
    "delta": {
     "D1": -1,
     "D7": -2,
     "D6": -1
    }
   },
   {
    "key": "E",
    "text": "当众替朋友对质，把事情闹大",
    "delta": {
     "D5": 2,
     "D6": 2,
     "D7": 2
    }
   }
  ]
 },
 {
  "id": 3,
  "theme": "热爱的追求·废部前夕",
  "style": "具体情境",
  "text": "你的社团就要废部了。你练了三年的剑道、篮球或乐队即将解散，老师劝你：别再浪费时间，回去好好学习。解散前的最后一场训练，你会——",
  "options": [
   {
    "key": "A",
    "text": "练到天黑，把欠下的全部还完",
    "delta": {
     "D10": 3,
     "D5": 2,
     "D1": 1
    }
   },
   {
    "key": "B",
    "text": "认真地问老师：坚持热爱，怎么就成浪费了",
    "delta": {
     "D7": 2,
     "D1": 2,
     "D2": 1
    }
   },
   {
    "key": "C",
    "text": "算了，反正升学要紧",
    "delta": {
     "D10": -2,
     "D1": -2,
     "D11": -1
    }
   },
   {
    "key": "D",
    "text": "一边抹眼泪一边打完整场",
    "delta": {
     "D5": 2,
     "D12": 1,
     "D10": 1
    }
   },
   {
    "key": "E",
    "text": "笑着办一场最盛大的告别，让全校都记住",
    "delta": {
     "D14": 2,
     "D5": 1,
     "D11": 1
    }
   }
  ]
 },
 {
  "id": 4,
  "theme": "爱情·爱的表达方式",
  "style": "抽象文艺",
  "text": "喜欢一个人时，你心底冒出来的第一个念头是——",
  "options": [
   {
    "key": "A",
    "text": "立刻冲过去告诉他，今晚就说，一秒都等不了",
    "delta": {
     "D9": 3,
     "D5": 2
    }
   },
   {
    "key": "B",
    "text": "偷偷对他好，好到他自己发现为止，绝不先开口",
    "delta": {
     "D9": -2,
     "D13": 2,
     "D4": 1
    }
   },
   {
    "key": "C",
    "text": "先评估一下我们合不合适、未来可不可能",
    "delta": {
     "D2": 2,
     "D9": -1,
     "D1": -1
    }
   },
   {
    "key": "D",
    "text": "把这份喜欢写进歌里 / 画进画里，让作品替我说话",
    "delta": {
     "D12": 2,
     "D9": -1,
     "D5": -1
    }
   },
   {
    "key": "E",
    "text": "喜欢就喜欢了呗，又不能当饭吃",
    "delta": {
     "D14": 2,
     "D9": -2,
     "D1": -2
    }
   }
  ]
 },
 {
  "id": 5,
  "theme": "爱情·告别与背叛",
  "style": "具体情境",
  "text": "夏日祭典的烟花升到半空时，你看见喜欢的人牵着另一个人的手，笑着从人群里走过。散场后他发来一句：我们，到此为止吧。你会——",
  "options": [
   {
    "key": "A",
    "text": "把对话框整个删掉，抬头把剩下的烟花看完",
    "delta": {
     "D5": -1,
     "D13": -2,
     "D9": -1
    }
   },
   {
    "key": "B",
    "text": "回他：哪里不够好，我可以改",
    "delta": {
     "D9": 1,
     "D4": 1,
     "D10": 1
    }
   },
   {
    "key": "C",
    "text": "回他：那就好好过。下次再见，我一定比你幸福",
    "delta": {
     "D11": 2,
     "D14": 2,
     "D5": 1
    }
   },
   {
    "key": "D",
    "text": "在浴缸里哭到天亮，把你们的故事一页页写成日记",
    "delta": {
     "D12": 1,
     "D5": 2,
     "D2": -1
    }
   },
   {
    "key": "E",
    "text": "回他：明天一起去吃那家拉面吧，像第一次那样",
    "delta": {
     "D13": 2,
     "D2": 1,
     "D8": 1
    }
   }
  ]
 },
 {
  "id": 6,
  "theme": "羁绊与牺牲·救生艇",
  "style": "具体情境",
  "text": "世界末日，最后一班救生艇只能载一个人。你手里握着那个名额，而岸上站着的是你生命中最重要的人。你会——",
  "options": [
   {
    "key": "A",
    "text": "把名额塞给他，然后转身走回人群里",
    "delta": {
     "D4": 2,
     "D13": 2,
     "D3": 1
    }
   },
   {
    "key": "B",
    "text": "先问清楚：真的只有这一艘船吗？",
    "delta": {
     "D2": 2,
     "D4": 1,
     "D6": 1
    }
   },
   {
    "key": "C",
    "text": "在名额上写下他的名字，塞进他手里：记住今晚的星空，就当我也在",
    "delta": {
     "D13": 2,
     "D2": 1,
     "D9": 1
    }
   },
   {
    "key": "D",
    "text": "把名额扔进海里：要么一起走，要么谁也别走",
    "delta": {
     "D5": 2,
     "D14": 1,
     "D4": 1
    }
   },
   {
    "key": "E",
    "text": "笑着骗他：船票给你，我在下一班等你。然后在岸上目送他离开",
    "delta": {
     "D3": 2,
     "D13": 1,
     "D9": -1
    }
   }
  ]
 },
 {
  "id": 7,
  "theme": "孤独与羁绊·凌晨便利店",
  "style": "具体情境",
  "text": "凌晨两点，你一个人坐在便利店的窗边吃关东煮，外面下着雨。此刻你心里在想——",
  "options": [
   {
    "key": "A",
    "text": "舒服，这一刻世界都是我的",
    "delta": {
     "D4": -2,
     "D14": 2,
     "D12": 1
    }
   },
   {
    "key": "B",
    "text": "有点冷清，但早就习惯了",
    "delta": {
     "D4": -1,
     "D5": -1,
     "D8": 1
    }
   },
   {
    "key": "C",
    "text": "掏出手机，给某个朋友发一句：睡了吗",
    "delta": {
     "D4": 2,
     "D9": 2,
     "D13": 1
    }
   },
   {
    "key": "D",
    "text": "无所谓，在哪都一样",
    "delta": {
     "D2": 1,
     "D14": 1,
     "D4": -1
    }
   },
   {
    "key": "E",
    "text": "孤独是变成强者的必经之路",
    "delta": {
     "D10": 2,
     "D11": 2,
     "D8": 1
    }
   }
  ]
 },
 {
  "id": 8,
  "theme": "信念与绝境·最后决战",
  "style": "具体情境",
  "text": "一场注定赢不了的战争，明早就是最后决战。同伴们都聚在篝火边，等你一句话。你会说——",
  "options": [
   {
    "key": "A",
    "text": "站到最前面：既然要输，也要让对手记住我们的名字",
    "delta": {
     "D10": 2,
     "D11": 2,
     "D5": 1
    }
   },
   {
    "key": "B",
    "text": "连夜研究地图：就算输，也要找一个输得有价值的位置",
    "delta": {
     "D10": 2,
     "D2": 1,
     "D5": -2
    }
   },
   {
    "key": "C",
    "text": "笑着劝大家：要不降了吧，活着才有以后",
    "delta": {
     "D1": -1,
     "D4": -1,
     "D14": 2
    }
   },
   {
    "key": "D",
    "text": "红了眼眶，一字一句：对不起，让你们跟我走到这一步",
    "delta": {
     "D5": 2,
     "D10": -1,
     "D2": -1
    }
   },
   {
    "key": "E",
    "text": "咧嘴一笑：那明天，谁负责给我收尸？",
    "delta": {
     "D14": 3,
     "D6": -1,
     "D1": -1
    }
   }
  ]
 },
 {
  "id": 9,
  "theme": "理想与现实·岔路口",
  "style": "具体情境",
  "text": "同时收到两个消息：一份薪水不错的稳定工作，和一个你一直梦想、但大概率会失败的机会。你会——",
  "options": [
   {
    "key": "A",
    "text": "选梦想，失败也比后悔强",
    "delta": {
     "D1": 3,
     "D10": 2,
     "D3": 1
    }
   },
   {
    "key": "B",
    "text": "先接稳定工作，业余再追梦",
    "delta": {
     "D2": 2,
     "D10": 1,
     "D1": -1
    }
   },
   {
    "key": "C",
    "text": "选稳定，梦想是留给幸运的人的",
    "delta": {
     "D1": -3,
     "D2": 1,
     "D14": 1
    }
   },
   {
    "key": "D",
    "text": "都不选，先想清楚自己要什么",
    "delta": {
     "D2": 2,
     "D12": 1,
     "D7": 1
    }
   },
   {
    "key": "E",
    "text": "接稳定工作，把工资一分分攒下来，攒够了再义无反顾",
    "delta": {
     "D10": 2,
     "D1": -1,
     "D14": 2
    }
   }
  ]
 },
 {
  "id": 10,
  "theme": "力量与自我·觉醒时刻",
  "style": "具体情境",
  "text": "你得到了一种强大的力量。全世界都在求你别用它，敌人因它而发抖，而第一个来求你的，是你最在乎的人。你会——",
  "options": [
   {
    "key": "A",
    "text": "听他的，收起力量，把日子过成自己喜欢的样子",
    "delta": {
     "D11": -2,
     "D10": 1,
     "D12": 1
    }
   },
   {
    "key": "B",
    "text": "告诉他：正因为我有了力量，才没人敢再欺负你",
    "delta": {
     "D11": 3,
     "D10": 2,
     "D5": 1
    }
   },
   {
    "key": "C",
    "text": "把力量交出去，让更冷静的人保管",
    "delta": {
     "D10": -2,
     "D3": 1,
     "D14": -1
    }
   },
   {
    "key": "D",
    "text": "我谁都不为，我只要自己变强",
    "delta": {
     "D2": 2,
     "D11": 2,
     "D7": 1
    }
   },
   {
    "key": "E",
    "text": "力量是力量，我还是我，该吃吃该睡睡",
    "delta": {
     "D14": 1,
     "D13": 1,
     "D11": -1
    }
   }
  ]
 },
 {
  "id": 11,
  "theme": "美好认知·雨天捡猫",
  "style": "具体情境",
  "text": "暴雨天，你在便利店门口捡到一只浑身湿透的流浪小猫。你会——",
  "options": [
   {
    "key": "A",
    "text": "蹲下来陪它淋一会儿，然后把外套脱给它",
    "delta": {
     "D13": 3,
     "D3": 2,
     "D5": 1
    }
   },
   {
    "key": "B",
    "text": "买最好的猫粮和箱子，带回家，从此多了个家人",
    "delta": {
     "D4": 2,
     "D3": 2,
     "D9": 1
    }
   },
   {
    "key": "C",
    "text": "拍照发朋友圈求助，找领养机构",
    "delta": {
     "D2": 2,
     "D13": 1,
     "D4": 1
    }
   },
   {
    "key": "D",
    "text": "心疼三秒，然后撑伞走人——我自己都养不活",
    "delta": {
     "D3": -2,
     "D13": -1,
     "D2": 1
    }
   },
   {
    "key": "E",
    "text": "把它举过头顶：走，以后你就是我兄弟了",
    "delta": {
     "D14": 2,
     "D5": 2,
     "D4": 1
    }
   }
  ]
 },
 {
  "id": 12,
  "theme": "美好认知·宇宙回信",
  "style": "抽象文艺",
  "text": "科学家说，整个宇宙里，可能只有人类这一种生物会仰望星空。你觉得这件事——",
  "options": [
   {
    "key": "A",
    "text": "美极了：我们是宇宙给自己写的一封情书",
    "delta": {
     "D12": 3,
     "D5": -1,
     "D8": -1
    }
   },
   {
    "key": "B",
    "text": "孤独极了：强者就要习惯一个人的宇宙",
    "delta": {
     "D11": 2,
     "D1": -1,
     "D13": -2
    }
   },
   {
    "key": "C",
    "text": "扯淡，滤镜加八个字的事",
    "delta": {
     "D12": -2,
     "D14": 2,
     "D1": -1
    }
   },
   {
    "key": "D",
    "text": "正因为孤独，我们才会互相照亮",
    "delta": {
     "D12": 2,
     "D13": 2,
     "D4": 1
    }
   },
   {
    "key": "E",
    "text": "宇宙归宇宙，明天还要上班",
    "delta": {
     "D2": 2,
     "D12": -1,
     "D14": -1
    }
   }
  ]
 },
 {
  "id": 13,
  "theme": "生命与死亡·一年期限",
  "style": "具体情境",
  "text": "体检报告上写着，你的人生只剩一年。走出医院大门，你第一件事会——",
  "options": [
   {
    "key": "A",
    "text": "立刻订张机票，去那些一直想去没去成的地方",
    "delta": {
     "D8": 2,
     "D5": 2,
     "D9": 1
    }
   },
   {
    "key": "B",
    "text": "把所有时间留给最重要的人，哪儿也不去",
    "delta": {
     "D4": 2,
     "D3": 1,
     "D13": 2
    }
   },
   {
    "key": "C",
    "text": "躲起来，谁也不见，一个人安静地走完",
    "delta": {
     "D4": -2,
     "D8": 1,
     "D5": -2
    }
   },
   {
    "key": "D",
    "text": "先崩溃三天，然后哭着把想吃的都吃一遍",
    "delta": {
     "D8": -2,
     "D5": 2,
     "D14": -1
    }
   },
   {
    "key": "E",
    "text": "去找医生理论：是不是拿错报告了？我不信",
    "delta": {
     "D8": -1,
     "D2": 1,
     "D7": 1
    }
   }
  ]
 },
 {
  "id": 14,
  "theme": "生命与死亡·存在感",
  "style": "抽象文艺",
  "text": "深夜，你独自坐在屋顶上看星星。忽然想到：如果此刻从这个世界消失，会有几个人真的记得我？——",
  "options": [
   {
    "key": "A",
    "text": "一定有人记得，所以我得好好活下去",
    "delta": {
     "D4": 2,
     "D8": 1,
     "D10": 1
    }
   },
   {
    "key": "B",
    "text": "无所谓记不记得，我来过就够了",
    "delta": {
     "D8": 2,
     "D12": 2,
     "D1": -1
    }
   },
   {
    "key": "C",
    "text": "只要我最在乎的那个人记得，就值了",
    "delta": {
     "D9": 2,
     "D4": 2,
     "D13": 1
    }
   },
   {
    "key": "D",
    "text": "这么一想，今晚就该做点能被记住的事",
    "delta": {
     "D10": 2,
     "D11": 2,
     "D5": 1
    }
   },
   {
    "key": "E",
    "text": "记得不记得，明天的饭还是要吃",
    "delta": {
     "D14": 2,
     "D8": 1,
     "D10": -1
    }
   }
  ]
 },
 {
  "id": 15,
  "theme": "正义与代价·按钮审判",
  "style": "具体情境",
  "text": "你发现，只要按下面前这个按钮，一百个正在制造灾难的人就会消失，换来一万人平安。代价是：从此每晚你都会梦见他们。你会——",
  "options": [
   {
    "key": "A",
    "text": "按下去：一万人的平安，比我的良心重要",
    "delta": {
     "D6": 3,
     "D3": 1,
     "D7": -1
    }
   },
   {
    "key": "B",
    "text": "先想办法：一定还有不用消失任何人的路",
    "delta": {
     "D6": 2,
     "D2": 1,
     "D4": 1
    }
   },
   {
    "key": "C",
    "text": "不按：我不是神，没资格决定谁消失",
    "delta": {
     "D6": -2,
     "D3": -2,
     "D2": 1
    }
   },
   {
    "key": "D",
    "text": "先不动，弄清楚按钮背后的原理和承诺，再判断它是不是真的有效",
    "delta": {
     "D2": 2,
     "D6": 1,
     "D14": 1
    }
   },
